# Reproduction template; put real credentials only in your ignored .env.
AMEM_LLM_BASE_URL=http://127.0.0.1:18000/v1
AMEM_LLM_MODEL=qwen3.8:27b
AMEM_LLM_API_KEY=dummy
AMEM_JUDGE_BASE_URL=http://127.0.0.1:18000/v1
AMEM_JUDGE_MODEL=qwen3.8:27b
AMEM_JUDGE_API_KEY=dummy
AMEM_TIMEOUT=900
AMEM_SOURCE_SCHEMA_MODE=strict
AMEM_PROVIDER_DROPS_UNIQUE_ITEMS=1
# Optional: point to a cached sentence-transformers/all-MiniLM-L6-v2 snapshot.
# AMEM_EMBEDDING_PATH=/path/to/all-MiniLM-L6-v2/snapshot
