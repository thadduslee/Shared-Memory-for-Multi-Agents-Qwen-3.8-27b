{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^r[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^c[0-9]+$"
          },
          "request_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "enum": [
              "current_items",
              "continuing_items",
              "retired_items",
              "conditions_and_exceptions",
              "supporting_items"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "enum": [
                    "authorized-record"
                  ]
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "evidence_id",
                "start",
                "end",
                "quote"
              ]
            }
          }
        },
        "required": [
          "id",
          "request_ids",
          "text",
          "category",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "requests",
    "claims"
  ]
}
