# SOCLAAS proxy for the same model. It takes no API key: leave the keys empty, since an
# empty "Bearer" header is rejected with 401 and the pipeline omits it. Copy to soclaas.env.
AMEM_LLM_BASE_URL=http://localhost:19000/v1
AMEM_LLM_MODEL=qwen3.8:27b
AMEM_LLM_API_KEY=
AMEM_JUDGE_BASE_URL=http://localhost:19000/v1
AMEM_JUDGE_MODEL=qwen3.8:27b
AMEM_JUDGE_API_KEY=
AMEM_TIMEOUT=900
# Local all-MiniLM-L6-v2 snapshot (revision 1110a243fdf4706b3f48f1d95db1a4f5529b4d41 in the run).
AMEM_EMBEDDING_PATH=/home/thaddus/.cache/huggingface/hub/models--sentence-transformers--all-MiniLM-L6-v2/snapshots/1110a243fdf4706b3f48f1d95db1a4f5529b4d41
AMEM_SOURCE_SCHEMA_MODE=strict
AMEM_PERMISSION_MAX_TOKENS=3072
AMEM_INCREMENTAL_MAX_TOKENS=2048
AMEM_ANSWER_MAX_TOKENS=4096
AMEM_VERIFY_MAX_TOKENS=4096
AMEM_PROVIDER_DROPS_UNIQUE_ITEMS=1
