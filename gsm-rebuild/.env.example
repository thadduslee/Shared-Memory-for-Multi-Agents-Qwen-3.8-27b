# Copy to .env and fill in. Placeholders only: never commit real values.

# --- Runtime mode -----------------------------------------------------------
# development | test | production. Production refuses to start with the
# development authenticator enabled or without an admin key.
GSM_ENV=development

# --- Database ---------------------------------------------------------------
# Owner/migration connection (needs CREATE and CREATEROLE for the first migration).
GSM_DATABASE_URL=postgresql+psycopg://gsm_owner:<password>@localhost:55432/gsm
# Non-superuser role the app switches to on every connection so row-level
# security applies. Created by migration 0001. Leave empty to disable (not recommended).
GSM_DB_APP_ROLE=gsm_app

# --- Authentication ---------------------------------------------------------
# Development authenticator: HMAC-signed X-GSM-Context header. Never enable in production.
GSM_DEV_AUTH_ENABLED=false
GSM_DEV_AUTH_SECRET=<random-32-bytes-hex>
# Admin API key for /admin routes. Unset disables the admin API.
GSM_ADMIN_API_KEY=<random-32-bytes-hex>
# Key for non-reconstructive audit hashes (query fingerprints). Unset = random per process.
GSM_AUDIT_HMAC_KEY=<random-32-bytes-hex>

# --- Deletion cascade -------------------------------------------------------
# inline: run the cascade right after the deletion transaction commits.
# deferred: leave jobs for `gsm cascade run` / POST /admin/cascades/run.
GSM_CASCADE_MODE=inline

# --- Retrieval --------------------------------------------------------------
GSM_TOP_K=8
GSM_LEXICAL_WEIGHT=0.6
GSM_VECTOR_WEIGHT=0.4
GSM_VECTOR_MIN_SIMILARITY=0.35

# --- Providers (all optional; deterministic fakes are the default) ----------
# embeddings: fake | openai_compat | none (lexical only)
GSM_EMBEDDINGS_PROVIDER=fake
GSM_EMBEDDING_DIM=256
# generator: deterministic | openai_compat
GSM_GENERATOR_PROVIDER=deterministic
# interpreter: rules | openai_compat
GSM_INTERPRETER_PROVIDER=rules
# semantic verifier: none | openai_compat (advisory only; can never loosen a block)
GSM_SEMANTIC_VERIFIER_PROVIDER=none

# OpenAI-compatible endpoint (vLLM, SGLang, hosted APIs)
GSM_LLM_BASE_URL=http://localhost:8000/v1
GSM_LLM_MODEL=<model-name>
GSM_LLM_API_KEY=<optional-api-key>
GSM_LLM_TIMEOUT_S=30
GSM_LLM_MAX_RETRIES=2
# Answer-generator output budget (reasoning models spend part of it thinking)
GSM_LLM_GENERATOR_MAX_TOKENS=4096
# Extra JSON merged into every chat request body, e.g. to disable thinking on Qwen:
# GSM_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
GSM_LLM_EXTRA_BODY=
GSM_EMBEDDINGS_MODEL=<embedding-model-name>
# Cost accounting for the evaluation report (USD per 1M tokens)
GSM_LLM_PRICE_INPUT_PER_MTOK=0
GSM_LLM_PRICE_OUTPUT_PER_MTOK=0
