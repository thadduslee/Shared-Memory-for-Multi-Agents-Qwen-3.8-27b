# Standalone A-MEM. Copy to .env; default model services are loopback-only.
AMEM_LLM_BASE_URL=http://127.0.0.1:8000/v1
AMEM_LLM_MODEL=Qwen/Qwen3.8-27B
AMEM_LLM_API_KEY=dummy
AMEM_JUDGE_BASE_URL=http://127.0.0.1:8001/v1
AMEM_JUDGE_MODEL=Qwen/Qwen3-14B
AMEM_JUDGE_API_KEY=dummy
AMEM_TIMEOUT=300
# Optional independent re-judge. Keep the real key only in your private .env;
# this command does not change the local judge configuration above.
AMEM_OPENROUTER_API_KEY=
AMEM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AMEM_OPENROUTER_JUDGE_MODEL=openai/gpt-4.1
AMEM_OPENROUTER_TIMEOUT=300
AMEM_OPENROUTER_JUDGE_MAX_TOKENS=2048
# Optional: explicit path to an already cached MiniLM snapshot.
# AMEM_EMBEDDING_PATH=/path/to/all-MiniLM-L6-v2/snapshot
