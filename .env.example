# Standalone A-MEM. Copy to .env; default model services are loopback-only.
AMEM_LLM_BASE_URL=http://127.0.0.1:8000/v1
AMEM_LLM_MODEL=Qwen/Qwen3.8-27B
AMEM_LLM_API_KEY=dummy
AMEM_JUDGE_BASE_URL=http://127.0.0.1:8001/v1
AMEM_JUDGE_MODEL=Qwen/Qwen3-14B
AMEM_JUDGE_API_KEY=dummy
AMEM_TIMEOUT=300
# Single-pass v13 permission responses; other model stages retain their budgets.
AMEM_PERMISSION_MAX_TOKENS=3072
# V16 ceiling; ordinary short responses consume only the tokens they need.
AMEM_INCREMENTAL_MAX_TOKENS=2048
# OpenRouter v16 run or independent re-judge. Put the real key only in .env.
# python -m evaluation.gatemem_medical.openrouter --run-dir runs/FRESH_DIRECTORY
# The full-run launcher uses qwen/qwen3.8-27b and openai/gpt-4.1 for this process,
# preserving the local endpoint settings above.
AMEM_OPENROUTER_API_KEY=
# OpenRouter sort: latency (default), throughput, or price.
AMEM_OPENROUTER_PROVIDER_SORT=latency
# Optional comma-separated provider slugs to skip for this process.
AMEM_OPENROUTER_PROVIDER_IGNORE=
AMEM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AMEM_OPENROUTER_JUDGE_MODEL=openai/gpt-4.1
AMEM_OPENROUTER_TIMEOUT=300
AMEM_OPENROUTER_JUDGE_MAX_TOKENS=2048
# Optional: explicit path to an already cached MiniLM snapshot.
# AMEM_EMBEDDING_PATH=/path/to/all-MiniLM-L6-v2/snapshot
## Optional preferred providers for the same model; compatible fallback stays enabled.
AMEM_OPENROUTER_PROVIDER_ORDER=
## V17 source transport: strict remote grammar or JSON with identical local validation.
AMEM_SOURCE_SCHEMA_MODE=strict
