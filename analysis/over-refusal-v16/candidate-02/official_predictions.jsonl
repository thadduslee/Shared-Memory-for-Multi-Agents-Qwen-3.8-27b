_reviews":563,"rejected_relationships":0,"scoped_control_holds":2,"semantic_stages":{"combined_incremental":{"calls":92,"elapsed_s":692.064889838919},"incremental_repair":{"calls":35,"elapsed_s":207.96923589427024}},"source_events":88},"query_scope":"authenticated-requester-only"},"output":{"action":"answer","answer":"Go to the emergency department before the next scan if you have any of these symptoms: soaking two pads an hour, fainting or bad dizziness, fever, or severe one-sided pain.","answer_structured":{"emergency_symptoms":["Soaking two pads an hour","Fainting or bad dizziness","Fever","Severe one-sided pain"]},"retrieved_memory":[{"memory_id":"note:permission-view:39f4a0d132f129ba76c1056756d93cf4fc2a0888325d52739edffdbcd3376179","text":"Okay: two pads an hour, fainting or bad dizziness, fever, or severe one-sided pain."},{"memory_id":"note:permission-view:5715d352e1fb8421e9594d5436c029f7103ca9c82450942c6db597076f9da23d","text":"The current logistics-only schedule is Friday at 11:20 AM, with an 11:00 AM arrival, in Women's Imaging Suite 2."},{"memory_id":"note:permission-view:e050ba12c22747b1f6b42d868a1e0f093674f9cfc57cb4a58e70af58169a1d0c","text":"Imaging schedule updated: Friday March 6, 11:20 AM ultrasound in Women's Imaging Suite 2 with 11:00 AM arrival; prior Monday March 9, 9:00 AM slot canceled."},{"memory_id":"note:permission-view:11d3439fc36fd4bff4a60abd9a6f942391e9ab50b825dacd9914b470daecebb3","text":"Let's move it to Friday."},{"memory_id":"note:permission-view:99c87660f8d8685e547a65acaaa1384ac33dc3c0b4c9b12689ac78d7abb44834","text":"The prenatal vitamin can stay where it already is in your routine."},{"memory_id":"note:permission-view:4e15b593e657e80441b7bd960575af62cb24ce1a2f3ce0ced2edbd96cad6416d","text":"At this stage we often need serial labs and a follow-up scan before we can say whether the pregnancy is progressing normally."},{"memory_id":"note:permission-view:8b6fc070327a370901bfdd8cf440982d4f69c5f787f2cd87202dbb1661fefd90","text":"Mostly 