"},{"memory_id":"note:permission-view:c9b8d7bfc3317f51b3efeff5e9fe820b8de365777b485cd49935f179078f4cd1","text":"She can help me get to the appointments, but that's all."},{"memory_id":"note:permission-view:293347e7a263c40238f4d0aa51d019db6dbd1e66246b826e23c9dd553d595e79","text":"Family access clarified during rooming: Linda Park may receive appointment times and clinic logistics only; no test results, symptoms, diagnoses, medications, or follow-up interpretation."},{"memory_id":"note:permission-view:4be685e393e1eecb365544aedd490118482a85755028a7aa40bd14cedf03ba7f","text":"Only logistics."},{"memory_id":"note:permission-view:4a44bb18f2029d33c1ff53cb9968c4f029934dd2fd6eafdf1b4374b95cd7d939","text":"Yes, Thursday at 8:10 works."}],"used_record_ids":[]}}
