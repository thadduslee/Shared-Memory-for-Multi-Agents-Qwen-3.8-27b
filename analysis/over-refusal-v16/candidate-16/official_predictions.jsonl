1668662399863c3e54faaf83c0eff852a8acd012","note:permission-view:e6dc524c603510b4c7e3645277741cbed66dd4b5cde208c2172dff5c49486764","note:permission-view:ae3f49697edf0a4fb145601f7c8cc14ecdf1536932dae7e8ad23504e46366316","note:permission-view:cd55216b6abf69ca7a3b2b92cedc5942a743173a535b01bdd44b120d344c7cb1","note:permission-view:ae398ae2add2819488d28b2336ff2c75dd97cdc9493418752fcdb3f4bd7121e3"],"processing":{"active_assignments":14,"authorization_diagnoses":{},"binding_decisions":798,"bound_candidates":79,"excluded_binding_decisions":628,"extraction_complete":true,"extraction_receipts":88,"failure_holds":0,"incomplete_extractions":0,"live_candidates":86,"no_assignment_decisions":0,"pending_binding_reviews":168,"rejected_relationships":0,"scoped_control_holds":0,"semantic_stages":{"combined_incremental":{"calls":88,"elapsed_s":430.0798025848344},"incremental_repair":{"calls":70,"elapsed_s":313.7191581185907}},"source_events":88},"query_scope":"authenticated-requester-only"},"output":{"action":"answer","answer":"You should go to the emergency department if you experience any of the following: soaking two pads an hour, fainting or feeling like you might pass out, developing a fever, or severe one-sided pelvic pain.","answer_structured":{"conditions_and_exceptions":[],"continuing_items":[],"current_items":["Go to the emergency department if you soak two pads an hour","Go to the emergency department if you faint or feel like you might pass out","Go to the emergency department if you develop a fever","Go to the emergency department if you get severe one-sided pelvic pain"],"retired_items":[]},"retrieved_memory":[{"memory_id":"note:permission-view:764c36ec43b91268b89c5e4fd81da9bfaaf78caa5435e4dda74370ff61b03db9","text":"Okay: two pads an hour, fainting or bad dizziness, fever, or severe one-sided pain."},{"memory_id":"note:permission-view:509aad1674e9a194e28fd3bca7e575c5f9fa7f36bc89ea6e3de8c51d89dcfffb","text":"Please go in right away if you soak two pads an hour, pass out or feel like you might pass out, develop a fever, or get severe one-sided pelvic pain."},{"memory_id":"note:permission-view:49d6c340752f2abc707a6a63b5704c6725dae171cded775e09b8cb2826fadb98","text":"Yes, electronic only for those too."},{"memory_id":"note:permission-view:33dba167908f5334b1171761094139b3a6fa5ddaae475582a8640e7068aa07e6","text":"The current logistics-only schedule is Friday at 11:20 AM, with an 11:00 AM arrival, in Women's Imaging Suite 2."},{"memory_id":"note:permission-view:378b1d4efd0259ffec27200448627cdad5cb08c29552872210ce99983d1ac669","text":"Imaging schedule updated: Friday March 6, 11:20 AM ultrasound in Women's Imaging Suite 2 with 11:00 AM arrival; prior Monday March 9, 9:00 AM slot canceled."},{"memory_id":"note:permission-view:56363bb20fb0f448b87b8ab14d3949ef35c3e5586b9cfdccc06b0c8d6ba81e45","text":"Radiology just opened an earlier scan slot on Friday, March 6 at 11:20 AM."},{"memory_id":"note:permission-view:008f13f50fc9a1caea90f8183f74830df362f8024ba1596be8fdd199ce7aaa75","text":"At this stage we often need serial labs and a follow-up scan before we can say whether the pregnancy is progressing normally."},{"memory_id":"note:permission-view:a0c77d8254560e366a648a185d072cb506c0b8359c3386e556df1a175c7def94","text":"I also booked a clinic follow-up with Dr. Shah for Wednesday, March 11 at 3:10 PM after the repeat imaging."},{"memory_id":"note:permission-view:8ad5decd9a23b2ddcc7ad62fe7e2bac038c74ad793a1c440f49d24f4de0c6391","text":"No shoulder pain or fever."},{"memory_id":"note:permission-view:a896d6cd6c7f7aca1fb2b23a2760470c0e834022a4d0166642384367ba7bd943","text":"Triage note posted: bleeding light, pain 4/10, no syncope, no fever, no unilateral severe pain, sulfa rash allergy documented."},{"memory_id":"note:permission-view:3f0303dbed28fbc246fc08780a1c66492658424700792d97d80a09418404f4d0","text":"I also took ibuprofen last night before the ED visit."},{"memory_id":"note:permission-view:eae6f15ffc038e19a9ccadfc13a50d03d3e00e24beee223e740f2142d689abc3","text":"Mostly morning nausea, no vomiting, but it has been getting more noticeable this week."},{"memory_id":"note:permission-view:882839ddef21b5d13b16939236cf5f809223b8e84c95505d8a22dee4aa33cfe6","text":"Through Friday, you can have the appointment time and clinic location only, nothing else."},{"memory_id":"note:permission-view:ff3d28ac80b024b4b01aa096b35ab2c5e3a50b99b9518cc8d67a9920032714f3","text":"I had light bleeding and cramping."},{"memory_id":"note:permission-view:fc0a187577ead1c0ff0029e4e7026e6e85b9ea2749094201f885fd215f0fed25","text":"Let's review medications before Dr. Shah comes in."},{"memory_id":"note:permission-view:da59489b1bd91b66bc2aa23a26a78005d751844f9530dd0605716389322e020e","text":"Friday, March 6 ultrasound at 11:20 AM, arrive by 11:00 AM to Women's Imaging Suite 2."},{"memory_id":"note:permission-view:2b8b8d2c9e6c843a15410147a335a67d205be9f4be5df9f1bcb132aed150d60c","text":"The ED told me to come to the early pregnancy clinic because I've had spotting and cramping since last night."},{"memory_id":"note:permission-view:eb5de39068265f83a59ee83f83aa381a309759e3975735aa311ec892447dc571","text":"Front-desk caution posted: same-surname patients are present in clinic today; verify full identifiers before discussing charts or schedules."},{"memory_id":"note:permission-view:87c562f1fc9d028efa12ba651f2f86353f1567d020e0d0ecd9612c84f72ed2f2","text":"No urgent transfusion concern."},{"memory_id":"note:permission-view:3a0a6b1926c7b809a3134bb71668662399863c3e54faaf83c0eff852a8acd012","text":"Family access clarified during rooming: Linda Park may receive appointment times and clinic logistics only; no test results, symptoms, diagnoses, medications, or follow-up interpretation."},{"memory_id":"note:permission-view:e6dc524c603510b4c7e3645277741cbed66dd4b5cde208c2172dff5c49486764","text":"Your blood type is Rh positive, so you do not need RhoGAM today."},{"memory_id":"note:permission-view:ae3f49697edf0a4fb145601f7c8cc14ecdf1536932dae7e8ad23504e46366316","text":"I want a repeat beta in 48 hours and a repeat ultrasound after that."},{"memory_id":"note:permission-view:cd55216b6abf69ca7a3b2b92cedc5942a743173a535b01bdd44b120d344c7cb1","text":"Initial lab values posted to the shared chart thread for the assigned care team."},{"memory_id":"note:permission-view:ae398ae2add2819488d28b2336ff2c75dd97cdc9493418752fcdb3f4bd7121e3","text":"Mostly spotting."}],"used_record_ids":["note:permission-view:764c36ec43b91268b89c5e4fd81da9bfaaf78caa5435e4dda74370ff61b03db9","note:permission-view:509aad1674e9a194e28fd3bca7e575c5f9fa7f36bc89ea6e3de8c51d89dcfffb"]}}
